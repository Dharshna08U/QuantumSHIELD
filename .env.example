# Copy to .env for local use. Replace every example value before deployment.
APP_ENV=development
DATABASE_URL=sqlite:///./quantumshield.db
POSTGRES_PASSWORD=replace-with-a-unique-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
INTEGRATION_TIMEOUT_SECONDS=3
AI_SERVICE_URL=http://localhost:8001
BLOCKCHAIN_SERVICE_URL=http://localhost:4000
PQC_PROVIDER=unavailable
PQC_PRIVATE_KEY_PATH=
PQC_PUBLIC_KEY_PATH=
PQC_KEM_PRIVATE_KEY_PATH=
PQC_RECIPIENT_PUBLIC_KEY_PATH=
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_API_TOKEN=
FABRIC_MSP_ID=
FABRIC_PEER_ENDPOINT=
FABRIC_PEER_HOST_ALIAS=
FABRIC_TLS_CERT_PATH=
FABRIC_CLIENT_CERT_PATH=
FABRIC_PRIVATE_KEY_PATH=
FABRIC_CHANNEL=
FABRIC_CHAINCODE=
AUTO_REMEDIATION_ENABLED=false
KUBERNETES_PROVIDER=unavailable
KUBERNETES_API_URL=
KUBERNETES_BEARER_TOKEN=
KUBERNETES_CA_FILE=
KUBERNETES_REMEDIATION_ENABLED=false
KUBERNETES_ALLOWED_NAMESPACES=
KUBERNETES_ALLOWED_DEPLOYMENTS=
KUBERNETES_MAX_REPLICAS=10
KUBERNETES_RESTART_THRESHOLD=5
KUBERNETES_REPEATED_CRASH_COUNT=3
KUBERNETES_EVENT_REASONS=FailedMount,FailedCreate,FailedScheduling,BackOff
KUBERNETES_WATCH_ENABLED=false
KUBERNETES_WATCH_INTERVAL_SECONDS=30
KUBERNETES_VERIFICATION_MAX_ATTEMPTS=5
KUBERNETES_VERIFICATION_DELAY_SECONDS=2
KUBERNETES_APPROVAL_TTL_MINUTES=30
KUBERNETES_APPROVAL_SEPARATION_OF_DUTIES=true
DEMO_MODE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
